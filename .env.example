# Copy this to .env and fill in your real values.
# Never commit .env to git.

PORT=3000

# Supabase — get these from your Supabase project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin dashboard credentials — change these before deploying
ADMIN_USER=admin
ADMIN_PASS=changeme-use-a-strong-password
